---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const research = (await getCollection('research')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allTalks = (await getCollection('talks')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const now = new Date();
const upcomingTalks = allTalks.filter(t => t.data.date > now);
const talks = allTalks.filter(t => t.data.date <= now);
const allMedia = (await getCollection('media')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredMedia = allMedia.filter(m => m.data.featured);
const listMedia = allMedia.filter(m => !m.data.featured);
const blogPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentBlog = blogPosts.slice(0, 4);
---

<Base title="Austin Larsen — Threat Intelligence">

  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1 class="hero-name" data-text="Austin Larsen">Austin Larsen</h1>

        <p class="hero-bio">
          Investigating the intrusions that make headlines.
          Nation-state threats, zero-days, and data extortion.
          Previously Mandiant.
        </p>
        <div class="hero-cta">
          <a href="#research" class="btn btn-primary">Research</a>
          <a href="/blog" class="btn btn-ghost">Blog</a>
        </div>
        {upcomingTalks.length > 0 && (
          <a href={upcomingTalks[0].data.url} target="_blank" rel="noopener" class="hero-upcoming">
            <span class="hero-upcoming-dot" aria-hidden="true"></span>
            <span class="hero-upcoming-text">
              <span class="hero-upcoming-label">upcoming</span>
              {upcomingTalks[0].data.conference} &mdash; {upcomingTalks[0].data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
            </span>
            <span class="hero-upcoming-register">Register →</span>
          </a>
        )}
      </div>
      <div class="hero-terminal">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- ══ AS FEATURED IN ══ -->
  <section class="press-strip" aria-label="As featured in">
    <p class="press-strip-label">// as featured in</p>
    <div class="marquee-wrap">
      <div class="marquee-track">
        <!-- Set 1 (visible, interactive) -->
        <div class="marquee-set">
          <a href="#media"><img src="/logos/bloomberg.svg" alt="Bloomberg" /></a>
          <a href="#media"><img src="/logos/reuters.svg" alt="Reuters" /></a>
          <a href="#media"><img src="/logos/fortune.svg" alt="Fortune" /></a>
          <a href="#media"><img src="/logos/newsweek.svg" alt="Newsweek" /></a>
          <a href="#media"><img src="/logos/techcrunch.svg" alt="TechCrunch" /></a>
          <a href="#media"><img src="/logos/cyberscoop.svg" alt="CyberScoop" /></a>
          <a href="#media"><img src="/logos/krebsonsecurity.svg" alt="Krebs on Security" /></a>
          <a href="#media"><img src="/logos/bleepingcomputer.svg" alt="BleepingComputer" /></a>
          <a href="#media"><img src="/logos/darkreading.svg" alt="Dark Reading" /></a>
          <a href="#media"><img src="/logos/theregister.svg" alt="The Register" /></a>
          <a href="#media"><img src="/logos/404media.svg" alt="404 Media" /></a>
        </div>
        <!-- Set 2 (aria-hidden duplicate for seamless loop) -->
        <div class="marquee-set" aria-hidden="true">
          <a href="#media" tabindex="-1"><img src="/logos/bloomberg.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/reuters.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/fortune.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/newsweek.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/techcrunch.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/cyberscoop.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/krebsonsecurity.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/bleepingcomputer.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/darkreading.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/theregister.svg" alt="" /></a>
          <a href="#media" tabindex="-1"><img src="/logos/404media.svg" alt="" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ RECENT BLOG ══ -->
  {recentBlog.length > 0 && (
    <section class="section" id="blog-preview">
      <div class="container">
        <p class="section-label reveal">// latest</p>
        <h2 class="section-title reveal" style="--i:1">Blog</h2>
        <div class="grid-2">
          {recentBlog.map((post, i) => (
            <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="card blog-card reveal" style={`--i:${Math.min(i, 3)}`}>
              <time class="blog-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
              <h3 class="blog-card-title">{post.data.title}</h3>
              {post.data.description && <p class="blog-card-desc">{post.data.description}</p>}
              <div class="card-footer">
                {post.data.tags.length > 0 && (
                  <div class="blog-tags">
                    {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
                  </div>
                )}
                <span class="read-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
        <div class="section-footer">
          <a href="/blog" class="view-all-link">View all posts &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <!-- ══ RESEARCH ══ -->
  <section class="section" id="research">
    <div class="container">
      <p class="section-label reveal">// threat intelligence</p>
      <h2 class="section-title reveal" style="--i:1">Research</h2>
      <div class="research-list">
        {research.map((item, i) => (
          <a href={item.data.url} target="_blank" rel="noopener" class:list={['card', 'research-card', 'reveal', { 'has-desc': !!item.data.description }]} style={`--i:${Math.min(i, 3)}`}>
            <div class="research-meta">
              <span class="badge">{item.data.publisher}</span>
              <time>{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
            </div>
            <h3 class="research-title">{item.data.title}</h3>
            {item.data.description && (
              <p class="research-desc">{item.data.description}</p>
            )}
            <div class="card-footer">
              {item.data.tags.length > 0 && (
                <div class="research-tags">
                  {item.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
                </div>
              )}
              <span class="read-arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ TALKS ══ -->
  <section class="section" id="talks">
    <div class="container">
      <p class="section-label reveal">// conferences</p>
      <h2 class="section-title reveal" style="--i:1">Talks &amp; Presentations</h2>

      {upcomingTalks.length > 0 && (
        <div class="upcoming-wrap">
          {upcomingTalks.map((talk) => (
            <a href={talk.data.url} target="_blank" rel="noopener" class="upcoming-card">
              {talk.data.image && (
                <div class="upcoming-img">
                  <Image src={talk.data.image} alt={talk.data.conference} width={360} loading="lazy" />
                </div>
              )}
              <div class="upcoming-body">
                <span class="upcoming-label">// upcoming</span>
                <h3 class="upcoming-title">{talk.data.conference}</h3>
                <time class="upcoming-date">
                  {talk.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {talk.data.location && <span class="upcoming-location"> — {talk.data.location}</span>}
                </time>
              </div>
              <div class="upcoming-cta">
                <span class="upcoming-btn">Register →</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="grid-3 talks-grid">
        {talks.map((talk, i) => (
          <a href={talk.data.url} target="_blank" rel="noopener" class="card talk-card reveal" style={`--i:${Math.min(i, 3)}`}>
            {talk.data.image && (
              <div class="talk-img-wrap">
                <Image src={talk.data.image} alt={talk.data.conference} width={400} loading="lazy" />
              </div>
            )}
            <div class="talk-info">
              <h3 class="talk-name">{talk.data.conference}</h3>
              <time class="talk-date">{talk.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ MEDIA ══ -->
  <section class="section" id="media">
    <div class="container">
      <p class="section-label reveal">// press &amp; coverage</p>
      <h2 class="section-title reveal" style="--i:1">Media</h2>

      {featuredMedia.length > 0 && (
        <div class="media-carousel-wrap">
          <div class="media-carousel">
            {featuredMedia.map((item, i) => (
              <a href={item.data.url} target="_blank" rel="noopener" class="media-feature-card reveal" style={`--i:${Math.min(i, 3)}`}>
                {item.data.image && (
                  <div class="media-feature-img">
                    <Image src={item.data.image} alt={item.data.title} width={520} loading="lazy" />
                    <div class="media-feature-overlay"></div>
                    {item.data.quote && (
                      <div class="media-feature-quote-overlay">
                        <p class="media-feature-quote">{item.data.quote}</p>
                      </div>
                    )}
                  </div>
                )}
                <div class="media-feature-info">
                  <div class="media-feature-meta">
                    <span class="media-feature-outlet">{item.data.outlet}</span>
                    <span class="badge">{item.data.type}</span>
                  </div>
                  <h3 class="media-feature-title">{item.data.title}</h3>
                  <time class="media-feature-date">{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {listMedia.length > 0 && (
        <ul class="media-list">
          {listMedia.map((item) => (
            <li class="media-list-item">
              <a href={item.data.url} target="_blank" rel="noopener" class:list={['media-list-link', { 'has-quote': !!item.data.quote }]}>
                <span class="media-list-outlet">{item.data.outlet}</span>
                <div class="media-list-center">
                  <span class="media-list-title">{item.data.title}</span>
                  {item.data.quote && (
                    <span class="media-list-quote">{item.data.quote}</span>
                  )}
                </div>
                <time class="media-list-date">{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

</Base>

<style>
  /* ── Section rhythm ── */
  :global(#research),
  :global(#media) {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  /* ── Hero ── */
  .hero {
    padding-top: calc(var(--nav-height) + 60px);
    padding-bottom: 60px;
    background: var(--bg-deep);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }
  .hero-org {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }
  .hero-bio {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 28px;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
  }
  .hero-upcoming {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 8px 14px;
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    max-width: fit-content;
  }
  .hero-upcoming:hover {
    border-color: var(--accent-dim);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--text-secondary);
  }
  .hero-upcoming-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }
  .hero-upcoming-label {
    color: var(--accent);
    margin-right: 4px;
  }
  .hero-upcoming-register {
    color: var(--accent);
    margin-left: 4px;
    white-space: nowrap;
  }
  .hero-terminal {
    display: flex;
    justify-content: flex-end;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    border-radius: 2px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--text-primary);
    color: var(--bg-deep);
  }
  .btn-primary:hover {
    background: #000;
    color: var(--bg-deep);
  }
  .btn-ghost {
    border: 1px solid var(--text-primary);
    color: var(--text-primary);
  }
  .btn-ghost:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  /* ── Blog cards ── */
  .blog-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 8px;
  }
  .blog-card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  .blog-card-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .blog-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .blog-card {
    display: block;
    color: inherit;
  }
  .blog-card:hover { color: inherit; }

  /* shared card-footer + arrow nudge */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
  }
  .read-arrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    display: inline-block;
    flex-shrink: 0;
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .blog-card:hover .read-arrow,
  .research-card:hover .read-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  /* ── Research ── */
  .research-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
  }
  .research-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 8px;
    border-bottom: 1px solid var(--border);
    border-left: none;
    border-right: none;
    border-top: none;
    border-radius: 0;
    background: transparent;
    color: inherit;
    transition: background 0.2s;
  }
  .research-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border);
    color: inherit;
  }
  .research-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 0;
  }
  .research-meta time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .research-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--text-primary);
    transition: opacity 0.2s ease;
  }
  /* Hover-reveal description — mirrors .media-list-quote behavior */
  .research-desc {
    font-size: 0.9rem;
    color: var(--accent);
    line-height: 1.55;
    font-style: italic;
    font-family: var(--font-display);
    display: block;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin: 0;
    transition: max-height 0.35s ease, opacity 0.25s ease, padding-top 0.25s ease;
    padding-top: 0;
  }
  .research-card.has-desc:hover .research-title {
    opacity: 0.35;
  }
  .research-card.has-desc:hover .research-desc {
    max-height: 8rem;
    opacity: 1;
    padding-top: 6px;
  }
  @media (max-width: 640px) {
    .research-desc {
      max-height: 8rem;
      opacity: 1;
      padding-top: 6px;
    }
    .research-card.has-desc:hover .research-title {
      opacity: 1;
    }
  }
  .research-tags {
    display: flex;
    gap: 8px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* ── Talks ── */
  .talk-card {
    display: block;
    color: inherit;
    padding: 0;
    overflow: hidden;
  }
  .talk-card:hover { color: inherit; }
  .talk-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
  }
  .talk-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s;
  }
  .talk-card:hover .talk-img-wrap img {
    transform: scale(1.03);
  }
  .talk-info {
    padding: 16px;
  }
  .talk-name {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .talk-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* ── Upcoming talk callout ── */
  .upcoming-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }
  .upcoming-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: 4px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s;
  }
  .upcoming-card:hover {
    background: var(--bg-card-hover);
    color: inherit;
  }
  .upcoming-img {
    flex-shrink: 0;
    width: 180px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .upcoming-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .upcoming-body {
    flex: 1;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .upcoming-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .upcoming-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .upcoming-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .upcoming-location {
    color: var(--text-muted);
  }
  .upcoming-cta {
    padding: 0 24px;
    flex-shrink: 0;
  }
  .upcoming-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    white-space: nowrap;
  }

  /* ── Media featured carousel ── */
  .media-carousel-wrap {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 32px;
  }
  .media-carousel-wrap::-webkit-scrollbar { display: none; }
  .media-carousel {
    display: grid;
    grid-template-columns: repeat(4, minmax(260px, 1fr));
    gap: 16px;
    padding-bottom: 4px;
  }
  .media-feature-card {
    display: flex;
    flex-direction: column;
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: inherit;
    transition: border-color 0.2s;
    text-decoration: none;
    flex-shrink: 0;
  }
  .media-feature-card:hover {
    border-color: var(--border-glow);
    color: inherit;
  }
  .media-feature-img {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .media-feature-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
    display: block;
  }
  .media-feature-card:hover .media-feature-img img {
    transform: scale(1.04);
  }
  .media-feature-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--text-primary) 35%, transparent) 0%, transparent 60%);
    transition: opacity 0.3s;
  }
  .media-feature-card:hover .media-feature-overlay {
    opacity: 0;
  }
  .media-feature-quote-overlay {
    position: absolute;
    inset: 0;
