---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => {
    // Precompute related posts once per page at build time so individual
    // page rendering doesn't have to re-scan and re-sort the full collection.
    const related = posts
      .filter(p => p.id !== post.id && p.data.tags.some(t => post.data.tags.includes(t)))
      .map(p => ({
        post: p,
        overlap: p.data.tags.filter(t => post.data.tags.includes(t)).length,
      }))
      .sort((a, b) => b.overlap - a.overlap || b.post.data.date.getTime() - a.post.data.date.getTime())
      .slice(0, 3)
      .map(x => x.post);

    return {
      params: { slug: post.id.replace(/\.md$/, '') },
      props: { post, related },
    };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Austin Larsen",
    "url": "https://austinlarsen.me"
  },
  "publisher": {
    "@type": "Person",
    "name": "Austin Larsen",
    "url": "https://austinlarsen.me"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).toString()
  },
  "keywords": post.data.tags.join(", ")
};
---

<Base title={`${post.data.title} — Austin Larsen`} description={post.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <article class="post">
    <div class="container post-container">
      <header class="post-header">
        <a href="/blog" class="post-back">&larr; Back to blog</a>
        <time class="post-date">{dateStr}</time>
        <h1 class="post-title">{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        )}
      </header>

      {post.data.image && (
        <div class="post-hero-image">
          <Image src={post.data.image} alt={post.data.title} width={720} />
        </div>
      )}

      <div class="post-body">
        <Content />
      </div>

      {post.data.linkedin && (
        <div class="post-linkedin">
          <hr class="post-linkedin-rule" />
          <a href={post.data.linkedin} target="_blank" rel="noopener noreferrer" class="post-linkedin-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            Originally posted on LinkedIn
          </a>
        </div>
      )}

      {related.length > 0 && (
        <aside class="post-related">
          <h2 class="post-related-title">// related posts</h2>
          <div class="post-related-list">
            {related.map(r => (
              <a href={`/blog/${r.id.replace(/\.md$/, '')}`} class="post-related-card">
                <time class="post-related-date">{r.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                <h3 class="post-related-card-title">{r.data.title}</h3>
                {r.data.description && <p class="post-related-desc">{r.data.description}</p>}
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</Base>

<style>
  .post {
    padding-top: calc(var(--nav-height) + 48px);
    padding-bottom: 80px;
  }
  .post-container {
    max-width: 720px;
  }
  .post-back {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .post-back:hover { color: var(--accent); }
  .post-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .post-title {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 16px;
    color: var(--text-primary);
  }
  .post-tags {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
  }
  .post-hero-image {
    margin-bottom: 40px;
  }
  .post-hero-image img {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  /* Prose styling */
  .post-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }
  .post-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin: 40px 0 16px;
  }
  .post-body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 32px 0 12px;
  }
  .post-body :global(p) {
    margin-bottom: 20px;
  }
  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-surface);
    padding: 2px 6px;
    border-radius: 2px;
  }
  .post-body :global(pre) {
    background: var(--term-bg);
    color: var(--term-text);
    border: 1px solid var(--term-border);
    border-radius: 4px;
    padding: 20px;
    overflow-x: auto;
    margin: 24px 0;
  }
  .post-body :global(pre code) {
    background: none;
    padding: 0;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.5;
  }
  .post-body :global(ul), .post-body :global(ol) {
    margin: 16px 0;
    padding-left: 24px;
  }
  .post-body :global(li) {
    margin-bottom: 8px;
  }
  .post-body :global(img) {
    border-radius: 4px;
    border: 1px solid var(--border);
    margin: 24px 0;
    max-width: 100%;
    height: auto;
  }
  .post-body :global(iframe) {
    border-radius: 4px;
    border: 1px solid var(--border);
    margin: 24px 0;
    width: 100%;
    aspect-ratio: 4 / 3;
  }
  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 40px 0;
  }
  .post-linkedin {
    margin-top: 48px;
  }
  .post-linkedin-rule {
    border: none;
    border-top: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .post-linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .post-linkedin-link:hover {
    color: var(--accent);
  }
  .post-body :global(.post-download-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 24px;
    padding: 10px 18px;
    border: 1px solid var(--text-primary);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.2s;
  }
  .post-body :global(.post-download-btn:hover) {
    background: var(--bg-surface);
    border-color: var(--text-primary);
  }

  /* Related posts */
  .post-related {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .post-related-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 20px;
    letter-spacing: 0.02em;
  }
  .post-related-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .post-related-card {
    display: block;
    padding: 18px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  .post-related-card:hover {
    border-color: var(--border-glow);
    background: var(--bg-card-hover);
    color: inherit;
  }
  .post-related-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 6px;
  }
  .post-related-card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .post-related-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
